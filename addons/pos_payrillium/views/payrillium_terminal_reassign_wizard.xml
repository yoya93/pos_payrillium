<odoo>
    <record id="view_payrillium_terminal_reassign_wizard_form" model="ir.ui.view">
        <field name="name">payrillium.terminal.reassign.wizard.form</field>
        <field name="model">payrillium.terminal.reassign.wizard</field>
        <field name="arch" type="xml">
            <form string="Reasignar terminal Payrillium">
                <group>
                    <p>
                        El terminal <b><field name="terminal_id" readonly="1"/></b> ya está asignado a la configuración <b><field name="old_config_id" readonly="1"/></b>.<br/>
                        ¿Quieres reasignarlo a la configuración <b><field name="new_config_id" readonly="1"/></b> y dejar la anterior sin terminal?
                    </p>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Reasignar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>